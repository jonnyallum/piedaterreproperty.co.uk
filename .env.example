# Copy to .env.local and fill in. Never commit a real value.

# Site
# Absolute production origin, used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://piedaterreproperty.co.uk
# Deployment posture. "preview" (default) noindexes everything via robots and an
# X-Robots-Tag header; "production" allows indexing. The build refuses to run as
# "production" unless NEXT_PUBLIC_ALLOW_INDEXING is also "true".
NEXT_PUBLIC_SITE_ENV=preview
# Set to "false" on the temporary preview domain so the site is noindex until cutover.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Sales department licensing gate. Keep "false" until HMRC AML supervision, TPO
# sales code cover and estate-agency professional indemnity are all confirmed.
# "true" switches the whole sales section from pre-launch to a live offer.
NEXT_PUBLIC_SALES_LIVE=false

# Lead delivery (Resend). Prompt 06.
RESEND_API_KEY=
# Verified sending domain address, for example enquiries@piedaterreproperty.co.uk
LEAD_FROM_EMAIL=
# Office inbox that receives lead notifications (falls back to the address in
# lib/site.ts if unset).
LEAD_NOTIFICATION_EMAIL=
# Optional second-channel alert webhook, called only if a lead email fails to
# send, so a lead is never lost silently.
LEAD_ALERT_WEBHOOK=

# Google Places reviews, cached server side. Prompt 10.
# Server-only, never exposed to the browser. Restrict the key by API and referrer
# or IP in the Google Cloud console.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Shared secret for the on-demand review revalidation route, so a new review can
# be pulled immediately. POST /api/reviews/revalidate with Authorization: Bearer.
REVIEWS_REVALIDATE_SECRET=

# Google Maps Platform, referrer restricted. Prompt 07 and 12.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Analytics. Prompt 11. GA4 stays gated behind cookie consent.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
# Server-side GA4 Measurement Protocol secret, so a lead conversion is still
# counted when the client tag is blocked. Pairs with NEXT_PUBLIC_GA4_MEASUREMENT_ID.
GA4_API_SECRET=

# Contact routes. Prompt 06.
NEXT_PUBLIC_WHATSAPP_NUMBER=
